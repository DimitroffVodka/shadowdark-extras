# Releases
module.zip
*.zip

# OS
Thumbs.db
.DS_Store

# Editor / agent scratch
.claude/
.gemini/
.planning/
.commandcode/
.hermes/
.vscode/
docs/claude/
docs/gemini/
Geminis-*.txt
AGENTS.md
GEMINI.md
CLAUDE.md
*.tmp
*.swp
# Project-scope MCP config: per-machine server commands and paths, so it is
# never the same file on two checkouts. Contrast openwiki/, which is also
# generated but IS committed — the update workflow's add-paths expects it there.
.mcp.json
# Browser console dumps from playwright-mcp runs, one file per session.
.playwright-mcp/

# Wiki review scratch. docs/wiki/ itself is published and gate-tested (see the
# wiki-links test), but .review/ holds drafts and image dumps that are not.
docs/wiki/.review/

# Literate-program export. Generated, and the generator lives outside this repo,
# so a committed copy would go stale with nothing to catch it.
shadowdark-extras.lit.md
shadowdark-extras.lit.map.json

# Cross-session handoff specs — internal working notes, never publish.
dev/HANDOFF-*.md

# Foundry LevelDB packs — source of truth is src/packs/<name>/*.yml.
# packs/ is BUILD OUTPUT: regenerated by `npm run pack` and by CI before
# building module.zip. Never commit this directory's contents.
packs/**/*.ldb
packs/**/*.log
packs/**/LOG
packs/**/LOG.old
packs/**/MANIFEST-*
packs/**/CURRENT
packs/**/LOCK
packs/**/lost/

# Node toolchain
node_modules/
# Both forms: a Traycer worktree symlinks node_modules at the checkout root, and
# a symlink is a file to git, so the trailing-slash form alone misses it.
node_modules
.deepcode/

# repowise index (local, machine-specific)
.repowise/

# repowise API keys (local)
.repowise/.env

# coverage reports
coverage.lcov

# debate-review transcripts (local, contains full diffs + model output)
.debate-review/
